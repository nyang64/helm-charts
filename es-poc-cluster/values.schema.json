{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "aimlp-search values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "clusterName": {
      "type": "string",
      "minLength": 1,
      "description": "Elasticsearch cluster.name"
    },
    "image": {
      "type": "object",
      "required": ["repository", "tag"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "security": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "tls": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "secretName": { "type": "string" },
        "issuerName": { "type": "string" },
        "duration": { "type": "string" },
        "renewBefore": { "type": "string" }
      }
    },
    "elasticPassword": {
      "type": "object",
      "properties": {
        "existingSecret": { "type": "string" },
        "password": { "type": "string" }
      }
    },
    "master": {
      "type": "object",
      "required": ["replicas"],
      "properties": {
        "replicas": { "type": "integer", "minimum": 1 },
        "heapSize": { "type": "string", "pattern": "^[0-9]+(m|g)$" },
        "antiAffinity": { "type": "string", "enum": ["required", "preferred", "disabled"] },
        "bootstrapped": { "type": "boolean" }
      }
    },
    "data": {
      "type": "object",
      "required": ["replicas"],
      "properties": {
        "replicas": { "type": "integer", "minimum": 1 },
        "heapSize": { "type": "string", "pattern": "^[0-9]+(m|g)$" },
        "antiAffinity": { "type": "string", "enum": ["required", "preferred", "disabled"] }
      }
    },
    "istio": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "allowedNamespaces": {
          "type": "array",
          "items": { "type": "string" }
        },
        "gateway": {
          "type": "object",
          "properties": {
            "hostname": { "type": "string" },
            "tls": {
              "type": "object",
              "properties": {
                "mode": { "type": "string", "enum": ["SIMPLE"] },
                "credentialName": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "esConfig": {
      "type": "object",
      "description": "Extra elasticsearch.yml key-value pairs merged after generated config",
      "additionalProperties": true
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "repository": {
          "type": "object",
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "type": { "type": "string", "enum": ["s3"] },
            "s3": {
              "type": "object",
              "properties": {
                "bucket": { "type": "string" },
                "basePath": { "type": "string" },
                "endpoint": { "type": "string", "description": "On-prem S3 bare hostname (no protocol prefix). The chart prepends `protocol` to form the full URL required by ES 9.x. Example: netapp-hpos.your-corp.internal" },
                "region": { "type": "string" },
                "pathStyleAccess": { "type": "boolean" },
                "protocol": { "type": "string", "enum": ["https", "http"] },
                "credentialsSecret": { "type": "string" }
              }
            }
          }
        },
        "slm": {
          "type": "object",
          "properties": {
            "schedule": { "type": "string" },
            "retention": {
              "type": "object",
              "properties": {
                "expireAfter": { "type": "string" },
                "minCount": { "type": "integer", "minimum": 0 },
                "maxCount": { "type": "integer", "minimum": 1 }
              }
            }
          }
        }
      }
    },
    "pdb": {
      "type": "object",
      "properties": {
        "master": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "minAvailable": { "type": "integer", "minimum": 0 }
          }
        },
        "data": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "minAvailable": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "sysctl": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "automountServiceAccountToken": { "type": "boolean" }
      }
    },
    "rbac": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" }
      }
    },
    "kibana": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "replicas": { "type": "integer", "minimum": 1 },
        "image": {
          "type": "object",
          "properties": {
            "repository": { "type": "string" },
            "tag": { "type": "string" },
            "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "serviceAccountToken": {
          "type": "object",
          "properties": {
            "existingSecret": { "type": "string" }
          }
        },
        "encryptionKeys": {
          "type": "object",
          "properties": {
            "existingSecret": { "type": "string" }
          }
        },
        "updateStrategy": { "type": "string", "enum": ["Recreate", "RollingUpdate"] },
        "antiAffinity": { "type": "string", "enum": ["required", "preferred", "disabled"] },
        "resources": {
          "type": "object",
          "properties": {
            "requests": { "type": "object" },
            "limits": { "type": "object" }
          }
        }
      }
    }
  }
}
